# ==============================================================================
# PalpiteArena — Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env e ajuste os valores se necessário:
# cp .env.example .env
# ==============================================================================

# --- Banco de Dados PostgreSQL (Container & Conexão Local) ---
POSTGRES_DB=palpitearena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- API Principal (Quarkus) ---
# Utilizadas pelo application.properties para desenvolvimento local e testes
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/palpitearena
API_PORT=8080

# --- Microsserviço de Notificações (Go) ---
NOTIFICACAO_PORT=8081
