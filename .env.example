# ==============================================================================
# PalpiteArena — Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env e ajuste os valores se necessário:
# cp .env.example .env
# Nunca faça commit de segredos reais no repositório!
# ==============================================================================

# --- Banco de Dados PostgreSQL (Container Local do Docker Compose) ---
POSTGRES_DB=palpitearena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- API Principal (Quarkus) ---
# Em produção (Render + Neon), estas variáveis são definidas como segredos no painel:
# Exemplo Neon: jdbc:postgresql://<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/palpitearena
API_PORT=8080
PORT=8080
JWT_SECRET=troque-este-segredo-em-producao

# --- Microsserviço de Notificações e Resultados (Go / gRPC) ---
NOTIFICACAO_HOST=localhost
NOTIFICACAO_PORT=8081
